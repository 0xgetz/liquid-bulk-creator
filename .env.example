# ── Batch ────────────────────────────────────────────────────────────────────
LBC_COUNT=1
LBC_CONCURRENCY=2
LBC_MIN_DELAY_MS=4000
LBC_MAX_DELAY_MS=12000
LBC_MAX_RETRIES=3

# ── Browser ──────────────────────────────────────────────────────────────────
LBC_HEADLESS=true
LBC_HUMAN_TYPING=true
LBC_CODE_TIMEOUT_MS=180000

# ── Inbox ────────────────────────────────────────────────────────────────────
# emailnator issues real @gmail.com; mail.tm is used automatically as fallback.
LBC_INBOX_PROVIDER=emailnator
LBC_INBOX_FALLBACK=true

# ── Rotating proxy (pick ONE strategy) ───────────────────────────────────────
# Strategy A — static list, assigned round-robin per account:
# LBC_PROXIES=http://user:pass@1.2.3.4:8000,http://user:pass@5.6.7.8:8000

# Strategy B — rotating gateway template; {session} gets a fresh value per
# account so each one exits from a different IP. {country} is optional.
# LBC_PROXY_TEMPLATE=http://user:pass@gw.proxy-provider.com:8000?session={session}&country={country}
# LBC_PROXY_COUNTRY=us
LBC_PROXY_ROTATE=true
LBC_PROXY_ROTATE_ON_FAILURE=true

# ── Output ───────────────────────────────────────────────────────────────────
LBC_OUTPUT_DIR=accounts
